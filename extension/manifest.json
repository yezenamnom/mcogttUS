{
  "manifest_version": 3,
  "name": "Comet ChatGPT Bridge",
  "version": "0.7.0",
  "description": "Secure browser bridge with isolated visible cursor overlay, deep DOM, CDP and resilient click fallbacks.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Comet ChatGPT Bridge"
  }
}
