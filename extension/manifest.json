{
  "manifest_version": 3,
  "name": "Comet ChatGPT Bridge",
  "version": "0.6.1",
  "description": "Secure browser bridge with deep DOM, Shadow DOM/iframe discovery, CDP and coordinate-control fallbacks.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Comet ChatGPT Bridge"
  }
}
