{
  "manifest_version": 3,
  "name": "Comet ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Local bridge that lets an authorized MCP server inspect and control Comet tabs.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Comet ChatGPT Bridge"
  }
}
